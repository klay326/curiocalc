# ─── Database ────────────────────────────────────────
POSTGRES_USER=curiocalc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=curiocalc
DATABASE_URL=postgresql+asyncpg://curiocalc:changeme@postgres:5432/curiocalc

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Cloudflare R2 (image storage) ───────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=curiocalc-media
R2_PUBLIC_URL=https://media.curiocalc.org

# ─── App ─────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
FIRST_SUPERUSER_EMAIL=admin@curiocalc.org
FIRST_SUPERUSER_PASSWORD=changeme
